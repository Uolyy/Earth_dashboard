# Настройки приложения «Орбитальный пост наблюдения».
#
# Файл .env не обязателен: приложение работает и без него, используя
# значения по умолчанию. Скопируйте этот файл как .env и изменяйте
# значения только при необходимости.
#
# ВАЖНО: файл .env обычно содержит секреты, поэтому он не должен
# попадать в систему контроля версий.

# Адрес и порт веб-сервера.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000

# Таймаут обращения к внешнему источнику данных, в секундах.
HTTP_TIMEOUT_SECONDS=15

# Количество повторов запроса при сетевой ошибке.
HTTP_RETRIES=2

# Срок жизни записи кэша по умолчанию, в секундах.
CACHE_TTL_SECONDS=900

# Идентификатор МКС в каталоге NORAD.
ISS_NORAD_ID=25544
